{
  "name": "@fabiocaccamo/utils.js",
  "version": "1.2.0",
  "description": "zero dependencies vanilla JavaScript utils.",
  "keywords": [
    "utils",
    "u",
    "array",
    "base64",
    "color",
    "date",
    "easing",
    "function",
    "geom",
    "hex",
    "interpolation",
    "json",
    "math",
    "number",
    "object",
    "random",
    "string",
    "test",
    "trigo",
    "trigonometry",
    "type",
    "url",
    "xml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabiocaccamo/utils.js"
  },
  "main": "dist/utils.js",
  "module": "./src/utils.js",
  "exports": {
    ".": {
      "import": "./src/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./array": "./src/utils/array.js",
    "./base64": "./src/utils/base64.js",
    "./color": "./src/utils/color.js",
    "./color/cmyk": "./src/utils/color/cmyk.js",
    "./color/hex": "./src/utils/color/hex.js",
    "./color/rgb": "./src/utils/color/rgb.js",
    "./date": "./src/utils/date.js",
    "./ease": "./src/utils/ease.js",
    "./func": "./src/utils/func.js",
    "./geom": "./src/utils/geom.js",
    "./geom/point": "./src/utils/geom/point.js",
    "./hex": "./src/utils/hex.js",
    "./interpolation": "./src/utils/interpolation.js",
    "./json": "./src/utils/json.js",
    "./math": "./src/utils/math.js",
    "./number": "./src/utils/number.js",
    "./object": "./src/utils/object.js",
    "./random": "./src/utils/random.js",
    "./string": "./src/utils/string.js",
    "./test": "./src/utils/test.js",
    "./trigo": "./src/utils/trigo.js",
    "./type": "./src/utils/type.js",
    "./url": "./src/utils/url.js",
    "./utf8": "./src/utils/utf8.js",
    "./xml": "./src/utils/xml.js"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production rimraf dist && rollup -c",
    "coverage": "nyc report --reporter=text-lcov > coverage.lcov",
    "docs": "npm run build --production && ./node_modules/.bin/jsdoc2md ./dist/utils.js > ./docs/API.md",
    "format": "prettier --config .prettierrc --loglevel warn --write src/utils/*.js && prettier --config .prettierrc --loglevel warn --write test/*.js",
    "test": "npm run build --production && nyc mocha",
    "watch": "rollup -c --watch",
    "test:treeshake": "node test/treeshake/treeshake.js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "jsdoc": "^4.0.4",
    "jsdoc-to-markdown": "^9.1.2",
    "mocha": "^11.7.3",
    "nyc": "^18.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.3",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "private": false
}
